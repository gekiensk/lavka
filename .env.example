# Подключение к базе PostgreSQL.
# Для локальной разработки поднимите базу командой `docker compose up -d` — эти значения уже подходят.
DATABASE_URL="postgresql://lavka:lavka@localhost:5432/lavka?schema=public"

# Адрес сайта без слеша в конце (нужен для sitemap, Open Graph, канонических ссылок)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Уведомления о заказах и заявках ──
# Telegram: создайте бота у @BotFather и получите токен.
# chat_id — ваш личный id или id группы (узнать можно у @userinfobot или @getidsbot).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email через SMTP (например, Яндекс: smtp.yandex.ru, порт 465, пароль приложения).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Куда присылать письма о заказах
NOTIFY_EMAIL=""
